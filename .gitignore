# 接入已有项目时只合并需要的规则，不覆盖原有规则。
.DS_Store
Thumbs.db

# 本机队列运行态不入库；.shell/queue/ledger.jsonl 必须入库，不要整体忽略 .shell/。
/.shell/local/
__pycache__/
*.pyc

# 项目工具的第三方依赖目录在此逐个排除。
/tool/diagram/node_modules/

# 工作对象：生成目录、依赖目录与本机密钥，与 object/AGENTS.md“忽略的目录与文件”一致。
DerivedData/
xcuserdata/
.build/
node_modules/
dist/
coverage/
.env
.env.*
!.env.example
*.p8

# Local iPhone server/signing configuration (example stays tracked).
/object/ios/Config/Local.xcconfig
