<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
	</array>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>0.1.0</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>safeorbit</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSCameraUsageDescription</key>
	<string>Scan your family’s SafeOrbit code to connect this phone.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Connect to the SafeOrbit development server on your local network.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>Share your location with your family in the background, so they can help if you lose your way.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Use your location for walking directions home or to your family member while SafeOrbit is open.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Record a spoken question so it can be turned into editable text.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Turn spoken questions into text before sending them in the Agent chat.</string>
	<key>AMapAPIKey</key>
	<string>$(AMAP_API_KEY)</string>
	<key>SafeOrbitServerURL</key>
	<string>$(SAFEORBIT_SERVER_URL)</string>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
		<string>location</string>
	</array>
</dict>
</plist>
